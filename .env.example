# --- Bunny.net (required for uploads) ---
# 1. Create a Storage Zone at https://dash.bunny.net/storage
#    Note its primary region endpoint (see "FTP & HTTP API Information"):
#      Frankfurt  -> https://storage.bunnycdn.com
#      London     -> https://uk.storage.bunnycdn.com
#      New York   -> https://ny.storage.bunnycdn.com
#      Los Angeles-> https://la.storage.bunnycdn.com
#      Singapore  -> https://sg.storage.bunnycdn.com
#      Sydney     -> https://syd.storage.bunnycdn.com
#      Stockholm  -> https://se.storage.bunnycdn.com
#      São Paulo  -> https://br.storage.bunnycdn.com
#      Johannesburg-> https://jh.storage.bunnycdn.com
BUNNY_STORAGE_ZONE=your-zone-name
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com

# 2. Create a Pull Zone connected to that Storage Zone, add a hostname.
#    Public file URLs become {CDN}/{fileName}
BUNNY_CDN_HOSTNAME=https://your-zone.b-cdn.net

# Gate password for the upload page (also set as Cloudflare secret: MASTER_PASSWORD)
MASTER_PASSWORD=200431

# Optional: used for share-link copy button
NEXT_PUBLIC_SITE_URL=http://localhost:3000
